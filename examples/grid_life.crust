// Game of Life, one generation. Demonstrates the grid utilities
// (grid, at, setAt, gridBounds, neighbors8) together: parse a grid
// from text, count live neighbors with a bounds-check-free at() +
// neighbors8() pair, and build the next generation with setAt() into
// a fresh newGrid() (no need to pre-size it -- setAt grows it to fit
// as it goes). A 3-cell vertical blinker becomes a 3-cell horizontal
// blinker after one step.

recipe countLiveNeighbors(g, pos) {
    count = 0
    knead n in neighbors8(pos) {
        order (at(g, n) == "#") {
            count += 1
        }
    }
    serve count
}

recipe step(g) {
    minRow, minCol, maxRow, maxCol = gridBounds(g)
    next = newGrid()

    knead r in minRow.<(maxRow + 1) {
        knead c in minCol.<(maxCol + 1) {
            live = countLiveNeighbors(g, (r, c))
            cell = at(g, (r, c))
            alive = (cell == "#" with (live == 2 or live == 3)) or (cell == "." with live == 3)
            setAt(next, (r, c), alive (| "#" |) ".")
        }
    }
    serve next
}

g = grid(".#.\n.#.\n.#.")
deliver(g)
deliver(step(g))
