// Demonstrates the nil-coalescing pair: (| (expression) and |) (assign
// only if nobox), plus the equivalent sauce() builtin they're sugar for.

recipe greet(name) {
    display = name (| "stranger"
    deliver("Hello, " + display + "!")
}

greet("Ryan")   // Hello, Ryan!
greet(nobox)    // Hello, stranger!

// same thing via the builtin instead of the operator
deliver(sauce(nobox, "stranger"))   // Hello, stranger! (well, just "stranger")

// memoized fibonacci: cache[n] only gets computed once per n
cache = {}

recipe fib(n) {
    cache[n] |) computeFib(n)
    serve cache[n]
}

recipe computeFib(n) {
    order (n < 2) {
        serve n
    }
    serve fib(n - 1) + fib(n - 2)
}

deliver(fib(10))
